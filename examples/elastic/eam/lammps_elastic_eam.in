# LAMMPS elastic constants - EAM (Cu-Zn)
units         metal
boundary      p p p
atom_style    atomic

read_data     structure.data

pair_style    eam/alloy
pair_coeff    * * CuZn_eam.alloy Cu Zn

min_style     cg
minimize      1.0e-10 1.0e-12 100000 1000000

compute       c_born all born
run           0

print "=== ELASTIC CONSTANTS (EAM) ==="
print "C11 C12 C13 C14 C15 C16:"
print "${c_born[1]} ${c_born[2]} ${c_born[3]} ${c_born[4]} ${c_born[5]} ${c_born[6]}"
print "C22 C23 C24 C25 C26:"
print "${c_born[7]} ${c_born[8]} ${c_born[9]} ${c_born[10]} ${c_born[11]}"
print "C33 C34 C35 C36:"
print "${c_born[12]} ${c_born[13]} ${c_born[14]} ${c_born[15]}"
print "C44 C45 C46:"
print "${c_born[16]} ${c_born[17]} ${c_born[18]}"
print "C55 C56:"
print "${c_born[19]} ${c_born[20]}"
print "C66:"
print "${c_born[21]}"
